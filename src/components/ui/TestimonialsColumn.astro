---
interface Testimonial {
  text: string;
  image: string;
  name: string;
  role: string;
}

interface Props {
  testimonials: Testimonial[];
  duration: number;
  class?: string;
}

const { testimonials, duration, class: className = "" } = Astro.props;
---

<div class={className}>
  <div 
    class="flex flex-col gap-6 animate-marquee-vertical hover:[animation-play-state:paused]"
    style={`--duration: ${duration}s;`}
  >
    {
      [...Array(2)].map(() => (
        <>
          {testimonials.map((t) => (
            <div class="glass-card p-7 rounded-2xl flex flex-col justify-between relative overflow-hidden group border border-brand-lavender/25 hover:border-brand-lavender/60 transition-all max-w-sm w-full mx-auto">
              <div class="space-y-4 relative z-10">
                <div class="w-8 h-8 rounded-full bg-brand-lavender/15 border border-brand-lavender/30 flex items-center justify-center text-brand-lavender font-serif text-xl font-bold shadow-inner">“</div>
                <p class="text-sm text-slate-200 leading-relaxed font-normal">
                  {t.text}
                </p>
              </div>
              <div class="flex items-center gap-3.5 pt-6 mt-6 border-t border-purple-900/40 relative z-10">
                <div class="w-11 h-11 rounded-full p-0.5 bg-gradient-to-tr from-brand-accent via-brand-lavender to-cyan-400 shadow-[0_0_12px_rgba(157,126,199,0.35)] flex-shrink-0">
                  <img src={t.image} alt={t.name} class="w-full h-full rounded-full object-cover" />
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white group-hover:text-brand-lavenderLight transition-colors">{t.name}</h4>
                  <p class="text-xs text-brand-lavenderLight/70 font-mono">{t.role}</p>
                </div>
              </div>
            </div>
          ))}
        </>
      ))
    }
  </div>
</div>
