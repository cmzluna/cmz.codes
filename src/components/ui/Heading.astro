---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
}

const { level = 1, class: className = '' } = Astro.props;

const fontSizes = {
  1: 'text-5xl md:text-6xl font-800 tracking-tight',
  2: 'text-4xl md:text-5xl font-700 tracking-tight',
  3: 'text-3xl md:text-4xl font-700',
  4: 'text-2xl md:text-3xl font-700',
  5: 'text-xl md:text-2xl font-600',
  6: 'text-lg md:text-xl font-600',
};

const Tag = `h${level}` as const;
---

<Tag class={`heading heading-${level} ${fontSizes[level]} ${className}`}>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.2;
  }

  .heading-1 {
    letter-spacing: -0.04em;
  }

  .heading-2 {
    letter-spacing: -0.02em;
  }

  .heading-3,
  .heading-4 {
    letter-spacing: -0.01em;
  }

  .heading-5,
  .heading-6 {
    letter-spacing: 0;
  }
</style>
