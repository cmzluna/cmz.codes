---
interface Props {
  testimonial: {
    text: string;
    name: string;
    role: string;
    accentColor: string;
    initials: string;
  };
}

const { testimonial } = Astro.props;

const colorMap: Record<string, { bg: string; text: string; border: string; quote: string }> = {
  "brand-lavender": {
    bg: "from-brand-accent via-brand-lavender to-cyan-400",
    text: "text-brand-lavenderLight",
    border: "border-purple-500/30",
    quote: "text-brand-lavender/10",
  },
  blue: {
    bg: "from-blue-500 via-indigo-400 to-cyan-400",
    text: "text-blue-200",
    border: "border-blue-500/30",
    quote: "text-blue-400/10",
  },
  emerald: {
    bg: "from-emerald-500 via-teal-400 to-cyan-400",
    text: "text-emerald-200",
    border: "border-emerald-500/30",
    quote: "text-emerald-400/10",
  },
  purple: {
    bg: "from-purple-500 via-pink-400 to-brand-lavender",
    text: "text-purple-200",
    border: "border-purple-500/30",
    quote: "text-purple-400/10",
  },
  rose: {
    bg: "from-rose-500 via-purple-400 to-brand-lavender",
    text: "text-rose-200",
    border: "border-rose-500/30",
    quote: "text-rose-400/10",
  },
};

const colors = colorMap[testimonial.accentColor] || colorMap["brand-lavender"];
---

<div class="glass-card p-6 rounded-2xl flex flex-col justify-between relative overflow-hidden group border border-brand-lavender/25 hover:border-brand-lavender/60 transition-all">
  <div class={`absolute -top-3 -right-2 text-7xl font-serif ${colors.quote} select-none pointer-events-none group-hover:${colors.quote} transition-colors`}>
    "
  </div>

  <div class="space-y-4 relative z-10">
    <div class={`w-8 h-8 rounded-full bg-${testimonial.accentColor.split("-")[0]}-500/15 border ${colors.border} flex items-center justify-center text-${testimonial.accentColor.split("-")[0]}-300 font-serif text-xl font-bold shadow-inner`}>
      "
    </div>
    <p class="text-sm text-slate-200 leading-relaxed font-normal">
      {testimonial.text}
    </p>
  </div>

  <div class="flex items-center gap-3.5 pt-6 mt-6 border-t border-purple-900/40 relative z-10">
    <div class={`w-11 h-11 rounded-full p-0.5 bg-gradient-to-tr ${colors.bg} shadow-[0_0_12px_rgba(157,126,199,0.35)] flex-shrink-0`}>
      <div class="w-full h-full rounded-full bg-slate-950 flex items-center justify-center font-bold text-xs" class:list={[colors.text]}>
        {testimonial.initials}
      </div>
    </div>
    <div>
      <h4 class="text-sm font-bold text-white group-hover:text-brand-lavenderLight transition-colors">
        {testimonial.name}
      </h4>
      <p class={`text-xs ${colors.text}/70 font-mono`}>
        {testimonial.role}
      </p>
    </div>
  </div>
</div>
