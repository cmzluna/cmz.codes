---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Claudio - React Native & Frontend Engineer">
  <div class="min-h-screen bg-gradient-to-b from-surface via-surface-container to-surface">
    <h1 class="text-4xl font-bold text-primary-light">Portfolio v2 - Astro + Tailwind</h1>
    <p class="mt-4 text-text-secondary">Coming soon...</p>
  </div>
</BaseLayout>

<style>
  :root {
    --color-primary-light: #4cd7f6;
    --color-surface: #0f131c;
    --color-surface-container: #1c2028;
    --color-text-secondary: #bcc9cd;
  }
</style>
